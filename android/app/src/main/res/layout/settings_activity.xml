<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0e1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="同花顺 API Key"
            android:textColor="#dbe2ef" />

        <EditText
            android:id="@+id/et_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="text"
            android:textColor="#dbe2ef"
            android:textColorHint="#8b96ad" />

        <Button
            android:id="@+id/btn_clear_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空 Key" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="轮询间隔（秒，≥5）"
            android:textColor="#dbe2ef" />

        <EditText
            android:id="@+id/et_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#dbe2ef" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="低开主栏区间（下 / 上，单位 %）"
            android:textColor="#dbe2ef" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_main_lo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="#dbe2ef" />

            <EditText
                android:id="@+id/et_main_hi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="#dbe2ef" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="深水副栏区间（下 / 上，单位 %）"
            android:textColor="#dbe2ef" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_deep_lo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="#dbe2ef" />

            <EditText
                android:id="@+id/et_deep_hi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="#dbe2ef" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="T-1 涨幅阈值（%）"
            android:textColor="#dbe2ef" />

        <EditText
            android:id="@+id/et_min_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="#dbe2ef" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="T-1 成交额阈值（亿元）"
            android:textColor="#dbe2ef" />

        <EditText
            android:id="@+id/et_min_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="#dbe2ef" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="30 日新高天数"
            android:textColor="#dbe2ef" />

        <EditText
            android:id="@+id/et_ndays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#dbe2ef" />

        <CheckBox
            android:id="@+id/cb_st"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="剔除 ST"
            android:textColor="#dbe2ef" />

        <CheckBox
            android:id="@+id/cb_bj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剔除北交所"
            android:textColor="#dbe2ef" />

        <Switch
            android:id="@+id/sw_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="声音提醒（命中/承接/走弱）"
            android:textColor="#dbe2ef" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存并热生效" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="取消" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="提示：修改区间/间隔无需重启服务，保存后下一轮轮询自动生效；Key 修改后下一轮请求即用新 Key。"
            android:textColor="#8b96ad"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
