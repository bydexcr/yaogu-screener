{
  "interval_seconds": 30,
  "data_dir": "data_mobile",
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8311,
    "token": ""
  },
  "strategy": {
    "t1_gain_min_pct": 8.0,
    "t1_volume_lt_t2": false,
    "require_new_high": false,
    "only_main_board": true,
    "high_ndays": 30,
    "t1_amount_min_yi": 10.0,
    "t_open_pct_range": [
      -10.0,
      -3.0
    ],
    "deep_open_pct_range": [
      -15.0,
      -10.0
    ]
  },
  "intraday": {
    "confirm_above_open": true,
    "broken_below_open_pct": -3.0,
    "broken_below_prev_pct": -9.0
  },
  "notify": {
    "enabled": true,
    "sound": true
  },
  "timezone": "Asia/Shanghai"
}
